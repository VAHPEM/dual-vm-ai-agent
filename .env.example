# Copy to .env (git-ignored) and fill in. labhand reads it from the repo root, or from
# the path in LABHAND_ENV. One SSH key for every host: .ssh_keys/labhand_ed25519 (or
# dualvm_ed25519), or the path in LABHAND_SSH_KEY.

# The lab hosts, in order; the first is the default host of every tool.
LABHAND_HOSTS=kali,windows

# Per host <NAME>_HOST, <NAME>_USER, <NAME>_OS (linux | windows), optional <NAME>_PYTHON
# (interpreter for run_script / jobs) and <NAME>_UTM_VM (the VM's name in UTM).
# <NAME> is the host name upper-cased, '-' -> '_'.
KALI_HOST=192.168.64.5
KALI_USER=analyst
KALI_OS=linux
KALI_PYTHON=/home/analyst/analysis-venv/bin/python3
KALI_UTM_VM=Kali Linux

WINDOWS_HOST=192.168.64.10
WINDOWS_USER=analyst
WINDOWS_OS=windows
WINDOWS_PYTHON=C:\Users\analyst\AppData\Local\Programs\Python\Python314\python.exe
WINDOWS_UTM_VM=Windows
